# Production build configuration for mikemiller.ai (values are public — safe to commit).
# Loaded automatically by `next build`. Local `npm run dev` does NOT read this file,
# so the contact form falls back to a mailto link during local development.

NEXT_PUBLIC_SITE_URL=https://mikemiller.ai

# Contact form backend: API Gateway (HTTP API) -> Lambda -> SES.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://xefv2yqmb8.execute-api.us-east-1.amazonaws.com/contact
