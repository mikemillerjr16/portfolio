# ---------------------------------------------------------------------------
# Example environment variables for the portfolio site.
# Copy this file to `.env.local` and fill in values as needed.
# NEVER commit real secrets. `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (used for canonical URLs, sitemap, OG).
# For local development the app falls back to http://localhost:3000.
# Production value lives in .env.production.
NEXT_PUBLIC_SITE_URL=https://mikemiller.ai

# --- Contact form backend (API Gateway -> Lambda -> SES) ------------------
# The form POSTs here. If unset (e.g. local dev), the form falls back to
# opening the visitor's mail client with a pre-filled message.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://xefv2yqmb8.execute-api.us-east-1.amazonaws.com/contact

# --- Analytics (optional, privacy-conscious; NOT enabled in prototype) ----
# The site ships with a no-op trackEvent() abstraction. To enable a
# privacy-friendly analytics provider later (e.g. Plausible / Fathom), set:
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
